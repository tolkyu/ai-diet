# ─── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-64-char-hex-string
API_V1_PREFIX=/api/v1

# ─── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_WEBHOOK_URL=https://yourdomain.com
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ai_diet
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_MAX_RETRIES=3
OPENAI_TIMEOUT=30

# ─── AWS S3 / MinIO ────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=ai-diet-photos
S3_ENDPOINT_URL=                    # Leave empty for AWS, set for MinIO

# ─── Subscription Limits ───────────────────────────────────────────────────────
FREE_DAILY_TEXT_ANALYSES=10
FREE_DAILY_PHOTO_ANALYSES=3

# ─── Security ──────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-another-random-64-char-hex
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=                         # Leave empty to disable Sentry
LOG_LEVEL=INFO
ADMIN_API_KEY=your_admin_api_key

# ─── Admin Telegram IDs (comma-separated, for /upgrade command) ────────────────
ADMIN_TELEGRAM_IDS=your_telegram_id_here

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_MESSAGES_PER_MINUTE=30
RATE_LIMIT_PHOTOS_PER_HOUR=20
